generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  CREATOR
  ADMIN
  SUPPORT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum CreatorAvailability {
  OFFLINE
  ONLINE
  BUSY
  LIVE
  AWAY
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  THUMBNAIL
  STREAM_RECORDING
  RECEIPT
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ContentType {
  PHOTOSET
  VIDEO
  AUDIO
  BUNDLE
  STREAM_REPLAY
  CUSTOM_VIDEO
}

enum ContentAccessType {
  FREE
  TOKEN_UNLOCK
  SUBSCRIPTION
  BUNDLE_INCLUDED
  PPV_MESSAGE
}

enum ContentVisibility {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  HIDDEN
}

enum AssetPurpose {
  COVER
  PREVIEW
  FULL
  THUMBNAIL
  GALLERY
  ATTACHMENT
  RECEIPT
  DELIVERY
}

enum AccessGrantSource {
  PURCHASE
  SUBSCRIPTION
  MANUAL
  PROMO
  BUNDLE
  MESSAGE_UNLOCK
}

enum SubscriptionInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum ServiceKind {
  PRIVATE_CHAT
  VIDEO_CALL
  CUSTOM_VIDEO
  CONTENT_BUNDLE
  VIP_PACKAGE
}

enum CustomRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  CANCELED
  REFUNDED
}

enum OrderType {
  TOKEN_TOP_UP
  CONTENT_PURCHASE
  SUBSCRIPTION_PURCHASE
  SERVICE_PURCHASE
  MESSAGE_UNLOCK
  TIP
  LIVE_ENTRY
  DIRECT_PAYMENT_COL
}

enum OrderStatus {
  DRAFT
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  PAID
  FULFILLED
  CANCELED
  REFUNDED
  FAILED
  EXPIRED
}

enum OrderItemType {
  TOKEN_PACKAGE
  CONTENT
  SUBSCRIPTION_PLAN
  SERVICE
  LIVE_SESSION
  TIP
  MESSAGE_UNLOCK
}

enum PaymentProvider {
  CCBILL
  SEGPAY
  CRYPTO_USDT
  CRYPTO_BTC
  DIRECT_COLOMBIA
  PAXUM
  MANUAL_BANK
  BANCOLOMBIA
  NEQUI
}

enum PaymentFlow {
  DEPOSIT
  WITHDRAWAL
  REFUND
  PAYOUT
}

enum PaymentStatus {
  PENDING
  REQUIRES_REVIEW
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
  EXPIRED
}

enum CryptoAsset {
  USDT
  BTC
}

enum CryptoNetwork {
  NONE
  TRC20
  ERC20
  BEP20
  BTC
}

enum LedgerDirection {
  CREDIT
  DEBIT
  HOLD
  RELEASE
}

enum TokenTransactionType {
  PURCHASE
  BONUS
  SPEND
  REFUND
  TIP_EARN
  TIP_SPEND
  SUBSCRIPTION
  PAYMENT_RELEASE
  PAYMENT_HOLD
  WITHDRAWAL_ADJUSTMENT
  MANUAL_ADJUSTMENT
  MESSAGE_UNLOCK
  LIVE_EVENT
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
  CANCELED
}

enum EarningSourceType {
  CONTENT_SALE
  SUBSCRIPTION_RENEWAL
  TIP
  PRIVATE_CHAT
  VIDEO_CALL
  CUSTOM_VIDEO
  LIVE_TIP
  ADJUSTMENT
  REFUND
  CHARGEBACK
}

enum EarningStatus {
  PENDING
  CLEARING
  AVAILABLE
  ON_HOLD
  PAID_OUT
  REVERSED
}

enum PayoutMethodType {
  PAXUM
  USDT_TRC20
  USDT_ERC20
  BTC
  BANCOLOMBIA
  NEQUI
  MANUAL_BANK
}

enum WithdrawalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELED
  FAILED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum ConversationType {
  PRIVATE_CHAT
  SUPPORT
  AI_CONCIERGE
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum ParticipantRole {
  CREATOR
  FAN
  AGENT
  ADMIN
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  SYSTEM
  OFFER
  TIP_EVENT
  UNLOCKABLE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  DELETED
}

enum AgentMode {
  CUSTOMER_SUPPORT
  CONTENT_CREATOR
  STRATEGY
  OPERATIONS
  ROLEPLAY
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
  ESCALATED
}

enum MemoryType {
  PREFERENCE
  PERSONAL_FACT
  BOUNDARY
  SALES_SIGNAL
  PURCHASE_PATTERN
  CONTENT_PREFERENCE
}

enum AutomationTrigger {
  INCOMING_MESSAGE
  ABANDONED_CART
  NEW_SUBSCRIBER
  LIVE_STARTED
  PAYMENT_FAILED
  VIP_ACTIVITY
}

enum AutomationAction {
  AUTO_REPLY
  TAG_FAN
  OFFER_DISCOUNT
  ESCALATE_TO_CREATOR
  CREATE_DRAFT
}

enum LiveProvider {
  LIVEKIT
  AGORA
  MANUAL
}

enum LiveAccessType {
  FREE
  SUBSCRIBERS_ONLY
  TOKEN_GATE
  VIP_ONLY
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

enum DirectPaymentChannel {
  BANCOLOMBIA
  NEQUI
  DAVIPLATA
  OTHER
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_PROOF
}

enum NotificationType {
  SYSTEM
  PAYMENT
  MESSAGE
  LIVE
  REVIEW
  MARKETING
  SECURITY
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum ConsentType {
  TERMS
  PRIVACY
  AGE_GATE
  MARKETING
  CRYPTO_RISK
  DIRECT_PAYMENT_POLICY
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum AuditActorType {
  USER
  SYSTEM
  AGENT
  WEBHOOK
}

model User {
  id                       String                     @id @default(cuid())
  email                    String                     @unique
  username                 String?                    @unique
  passwordHash             String?
  role                     UserRole                   @default(CUSTOMER)
  status                   UserStatus                 @default(PENDING)
  locale                   String                     @default("es-CO")
  timezone                 String                     @default("America/Bogota")
  preferredCurrency        String                     @default("USD")
  countryCode              String?                    @db.VarChar(2)
  dateOfBirth              DateTime?
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  lastActiveAt             DateTime?
  marketingOptIn           Boolean                    @default(false)
  isAgeVerified            Boolean                    @default(false)
  twoFactorEnabled         Boolean                    @default(false)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  profile                  UserProfile?
  creatorProfile           CreatorProfile?
  tokenWallet              TokenWallet?
  tokenTransactions        TokenTransaction[]         @relation("WalletUser")
  paymentTransactions      PaymentTransaction[]       @relation("UserPaymentTransactions")
  creatorPaymentEvents     PaymentTransaction[]       @relation("CreatorPaymentTransactions")
  customerOrders           Order[]                    @relation("CustomerOrders")
  creatorOrders            Order[]                    @relation("CreatorOrders")
  ownedMediaAssets         MediaAsset[]               @relation("OwnedMediaAssets")
  creatorMediaAssets       MediaAsset[]               @relation("CreatorMediaAssets")
  creatorTokenPackages     TokenPackage[]             @relation("CreatorTokenPackages")
  creatorServiceOfferings  ServiceOffering[]          @relation("CreatorServiceOfferings")
  creatorSubscriptionPlans SubscriptionPlan[]         @relation("CreatorSubscriptionPlans")
  createdContent           ContentItem[]              @relation("CreatorContent")
  contentAccessGrants      ContentAccessGrant[]
  subscriptions            FanSubscription[]          @relation("FanSubscriptionsUser")
  subscriberPlans          FanSubscription[]          @relation("CreatorSubscriptionsUser")
  reviewsWritten           Review[]                   @relation("ReviewsWritten")
  reviewsReceived          Review[]                   @relation("CreatorReviews")
  customerConversations    Conversation[]             @relation("CustomerConversations")
  creatorConversations     Conversation[]             @relation("CreatorConversations")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                  @relation("SentMessages")
  messageUnlocks           MessageUnlock[]
  tipsSent                 Tip[]                      @relation("TipsSent")
  tipsReceived             Tip[]                      @relation("TipsReceived")
  payoutMethods            PayoutMethod[]
  creatorBalance           CreatorBalance?
  creatorEarnings          CreatorEarningLedger[]     @relation("CreatorEarnings")
  withdrawalRequests       WithdrawalRequest[]        @relation("CreatorWithdrawalRequests")
  reviewedWithdrawals      WithdrawalRequest[]        @relation("ReviewedWithdrawalRequests")
  directPaymentSubmissions DirectPaymentSubmission[]  @relation("DirectPaymentsByUser")
  directPaymentSales       DirectPaymentSubmission[]  @relation("DirectPaymentsForCreator")
  reviewedDirectPayments   DirectPaymentSubmission[]  @relation("DirectPaymentReviewers")
  notifications            Notification[]
  consents                 UserConsent[]
  ageVerificationChecks    AgeVerificationCheck[]
  kycChecks                KycCheck[]
  aiAgentProfile           AIAgentProfile?
  agentRunsTriggered       AIAgentRun[]               @relation("TriggeredAgentRuns")
  fanMemories              AIAgentMemory[]            @relation("FanMemories")
  liveSessions             LiveSession[]              @relation("CreatorLiveSessions")
  liveSessionViewers       LiveSessionViewer[]
  customRequestsAsCustomer CustomRequest[]            @relation("CustomRequestsCustomer")
  customRequestsAsCreator  CustomRequest[]            @relation("CustomRequestsCreator")
  auditLogs                AuditLog[]                 @relation("AuditActorUser")

  @@index([role, status])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  displayName  String?
  headline     String?
  bio          String?     @db.Text
  city         String?
  country      String?
  pronouns     String?
  languages    Json?
  socialLinks  Json?
  websiteUrl   String?
  avatarAssetId String?
  coverAssetId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset  MediaAsset? @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  coverAsset   MediaAsset? @relation("ProfileCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
}

model CreatorProfile {
  id                             String             @id @default(cuid())
  userId                         String             @unique
  slug                           String             @unique
  stageName                      String
  brandName                      String
  tagline                        String?
  shortBio                       String?            @db.VarChar(240)
  fullBio                        String?            @db.Text
  status                         CreatorAvailability @default(OFFLINE)
  isFeatured                     Boolean            @default(false)
  isVerified                     Boolean            @default(false)
  platformFeeBps                 Int                @default(2000)
  primaryPayoutCurrency          String             @default("USD")
  acceptingDirectColombiaPayments Boolean           @default(true)
  chatRateTokens                 Int                @default(30)
  videoCallRateTokens            Int                @default(250)
  customVideoBaseTokens          Int                @default(600)
  subscriptionBaseTokens         Int                @default(700)
  minimumTipTokens               Int                @default(20)
  ratingAverage                  Decimal            @default(0) @db.Decimal(4, 2)
  ratingCount                    Int                @default(0)
  languages                      Json?
  publicFlags                    Json?
  heroAssetId                    String?
  introVideoAssetId              String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  user                           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  heroAsset                      MediaAsset?        @relation("CreatorHeroAsset", fields: [heroAssetId], references: [id], onDelete: SetNull)
  introVideoAsset                MediaAsset?        @relation("CreatorIntroAsset", fields: [introVideoAssetId], references: [id], onDelete: SetNull)
}

model MediaAsset {
  id                    String               @id @default(cuid())
  ownerUserId           String
  creatorId             String?
  kind                  MediaKind
  visibility            MediaVisibility      @default(PRIVATE)
  moderationStatus      ModerationStatus     @default(PENDING)
  storageProvider       String               @default("cloudinary")
  cloudinaryPublicId    String?
  publicUrl             String
  secureUrl             String?
  mimeType              String?
  extension             String?
  bytes                 Int?
  width                 Int?
  height                Int?
  durationSeconds       Int?
  blurDataUrl           String?              @db.Text
  altText               String?
  isNsfw                Boolean              @default(false)
  metadata              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  ownerUser             User                 @relation("OwnedMediaAssets", fields: [ownerUserId], references: [id], onDelete: Cascade)
  creator               User?                @relation("CreatorMediaAssets", fields: [creatorId], references: [id], onDelete: SetNull)
  profileAvatarFor      UserProfile[]        @relation("ProfileAvatar")
  profileCoverFor       UserProfile[]        @relation("ProfileCover")
  creatorHeroFor        CreatorProfile[]     @relation("CreatorHeroAsset")
  creatorIntroFor       CreatorProfile[]     @relation("CreatorIntroAsset")
  contentCovers         ContentItem[]        @relation("ContentCover")
  contentPreviews       ContentItem[]        @relation("ContentPreview")
  contentAssets         ContentAsset[]
  liveReplayFor         LiveSession[]        @relation("LiveReplayAsset")
  directPaymentReceipts DirectPaymentSubmission[] @relation("DirectPaymentReceipt")

  @@index([ownerUserId, kind])
  @@index([creatorId, visibility])
}

model TokenWallet {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  availableTokens        Int                @default(0)
  lockedTokens           Int                @default(0)
  lifetimePurchasedTokens Int               @default(0)
  lifetimeSpentTokens    Int                @default(0)
  lifetimeEarnedTokens   Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries                TokenTransaction[]
}

model TokenTransaction {
  id                   String             @id @default(cuid())
  walletId             String
  userId               String
  orderId              String?
  paymentTransactionId String?
  type                 TokenTransactionType
  direction            LedgerDirection
  status               LedgerEntryStatus   @default(POSTED)
  tokenAmount          Int
  balanceAfter         Int?
  usdAmount            Decimal?            @db.Decimal(12, 2)
  copAmount            Decimal?            @db.Decimal(12, 2)
  description          String?
  referenceType        String?
  referenceId          String?
  metadata             Json?
  createdAt            DateTime            @default(now())
  wallet               TokenWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                 User                @relation("WalletUser", fields: [userId], references: [id], onDelete: Cascade)
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([userId, type])
  @@index([referenceType, referenceId])
}

model TokenPackage {
  id           String    @id @default(cuid())
  creatorId    String
  code         String    @unique
  name         String
  description  String?
  tokens       Int
  bonusTokens  Int       @default(0)
  totalTokens  Int
  priceUsd     Decimal   @db.Decimal(12, 2)
  priceCop     Decimal?  @db.Decimal(12, 2)
  isFeatured   Boolean   @default(false)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  creator      User      @relation("CreatorTokenPackages", fields: [creatorId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([creatorId, isActive, sortOrder])
}

model SubscriptionPlan {
  id             String               @id @default(cuid())
  creatorId      String
  slug           String               @unique
  name           String
  description    String?              @db.Text
  priceTokens    Int
  billingInterval SubscriptionInterval @default(MONTHLY)
  trialDays      Int                  @default(0)
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  perks          Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  creator        User                 @relation("CreatorSubscriptionPlans", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions  FanSubscription[]
  orderItems     OrderItem[]

  @@index([creatorId, isActive, sortOrder])
}

model FanSubscription {
  id                String              @id @default(cuid())
  userId            String
  creatorId         String
  planId            String
  originOrderId     String?
  status            SubscriptionStatus  @default(PENDING)
  autoRenew         Boolean             @default(true)
  renewsWithTokens  Boolean             @default(true)
  renewalTokenPrice Int?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  cancelAt          DateTime?
  canceledAt        DateTime?
  endedAt           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation("FanSubscriptionsUser", fields: [userId], references: [id], onDelete: Cascade)
  creator           User                @relation("CreatorSubscriptionsUser", fields: [creatorId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  originOrder       Order?              @relation("OrderSubscriptions", fields: [originOrderId], references: [id], onDelete: SetNull)
  accessGrants      ContentAccessGrant[]

  @@index([userId, status])
  @@index([creatorId, status])
}

model ServiceOffering {
  id               String        @id @default(cuid())
  creatorId        String
  slug             String        @unique
  kind             ServiceKind
  name             String
  description      String?       @db.Text
  basePriceTokens  Int
  durationMinutes  Int?
  turnaroundHours  Int?
  inventoryPerDay  Int?
  isHighlighted    Boolean       @default(false)
  isActive         Boolean       @default(true)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  creator          User          @relation("CreatorServiceOfferings", fields: [creatorId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  customRequests   CustomRequest[]

  @@index([creatorId, kind, isActive])
}

model ContentItem {
  id                String             @id @default(cuid())
  creatorId         String
  slug              String             @unique
  title             String
  excerpt           String?            @db.VarChar(240)
  description       String?            @db.Text
  type              ContentType
  accessType        ContentAccessType  @default(TOKEN_UNLOCK)
  visibility        ContentVisibility  @default(DRAFT)
  priceTokens       Int?
  isExplicit        Boolean            @default(true)
  allowReviews      Boolean            @default(true)
  releaseAt         DateTime?
  publishedAt       DateTime?
  coverAssetId      String?
  previewAssetId    String?
  metadata          Json?
  viewCount         Int                @default(0)
  unlockCount       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  creator           User               @relation("CreatorContent", fields: [creatorId], references: [id], onDelete: Cascade)
  coverAsset        MediaAsset?        @relation("ContentCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  previewAsset      MediaAsset?        @relation("ContentPreview", fields: [previewAssetId], references: [id], onDelete: SetNull)
  assets            ContentAsset[]
  accessGrants      ContentAccessGrant[]
  reviews           Review[]           @relation("ContentReviews")
  orderItems        OrderItem[]
  deliveredRequests CustomRequest[]    @relation("DeliveredContent")

  @@index([creatorId, visibility, publishedAt])
  @@index([accessType, type])
}

model ContentAsset {
  id        String       @id @default(cuid())
  contentId String
  assetId   String
  purpose   AssetPurpose
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  content   ContentItem  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset     MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contentId, assetId, purpose])
  @@index([contentId, purpose, sortOrder])
}

model ContentAccessGrant {
  id             String             @id @default(cuid())
  userId         String
  contentId      String
  orderItemId    String?
  subscriptionId String?
  source         AccessGrantSource
  grantedAt      DateTime           @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  metadata       Json?
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        ContentItem        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  subscription   FanSubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, contentId])
  @@index([subscriptionId])
}

model Order {
  id                 String             @id @default(cuid())
  customerId         String
  creatorId          String?
  type               OrderType
  status             OrderStatus        @default(PENDING)
  currencyCode       String             @default("USD")
  subtotalAmount     Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal            @default(0) @db.Decimal(12, 2)
  totalTokens        Int?
  notes              String?            @db.Text
  metadata           Json?
  paidAt             DateTime?
  fulfilledAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           User               @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  creator            User?              @relation("CreatorOrders", fields: [creatorId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  paymentTransactions PaymentTransaction[]
  tokenTransactions  TokenTransaction[]
  messageUnlocks     MessageUnlock[]
  tips               Tip[]
  subscriptions      FanSubscription[]  @relation("OrderSubscriptions")
  reviews            Review[]
  directPaymentSubmission DirectPaymentSubmission?
  creatorEarnings    CreatorEarningLedger[]

  @@index([customerId, status, createdAt])
  @@index([creatorId, type, status])
}

model OrderItem {
  id                 String            @id @default(cuid())
  orderId            String
  type               OrderItemType
  tokenPackageId     String?
  contentId          String?
  subscriptionPlanId String?
  serviceOfferingId  String?
  liveSessionId      String?
  quantity           Int               @default(1)
  unitAmount         Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal           @default(0) @db.Decimal(12, 2)
  tokensAmount       Int?
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenPackage       TokenPackage?     @relation(fields: [tokenPackageId], references: [id], onDelete: SetNull)
  content            ContentItem?      @relation(fields: [contentId], references: [id], onDelete: SetNull)
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  serviceOffering    ServiceOffering?  @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  liveSession        LiveSession?      @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  accessGrants       ContentAccessGrant[]
  customRequest      CustomRequest?

  @@index([orderId, type])
}

model PaymentTransaction {
  id                  String              @id @default(cuid())
  userId              String
  creatorId           String?
  orderId             String?
  flow                PaymentFlow
  provider            PaymentProvider
  status              PaymentStatus       @default(PENDING)
  currencyCode        String              @default("USD")
  fiatAmount          Decimal             @default(0) @db.Decimal(12, 2)
  feeAmount           Decimal             @default(0) @db.Decimal(12, 2)
  netAmount           Decimal             @default(0) @db.Decimal(12, 2)
  exchangeRate        Decimal?            @db.Decimal(18, 8)
  cryptoAsset         CryptoAsset?
  cryptoNetwork       CryptoNetwork       @default(NONE)
  walletAddress       String?
  txHash              String?
  externalReference   String?
  providerCustomerId  String?
  providerPaymentId   String?
  failureReason       String?             @db.Text
  payload             Json?
  confirmedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation("UserPaymentTransactions", fields: [userId], references: [id], onDelete: Cascade)
  creator             User?               @relation("CreatorPaymentTransactions", fields: [creatorId], references: [id], onDelete: SetNull)
  order               Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tokenTransactions   TokenTransaction[]
  directPaymentSubmission DirectPaymentSubmission?
  creatorEarnings     CreatorEarningLedger[]

  @@index([userId, status, createdAt])
  @@index([provider, status])
  @@index([externalReference])
}

model CreatorBalance {
  id                 String    @id @default(cuid())
  creatorId          String    @unique
  pendingAmountUsd   Decimal   @default(0) @db.Decimal(14, 2)
  availableAmountUsd Decimal   @default(0) @db.Decimal(14, 2)
  onHoldAmountUsd    Decimal   @default(0) @db.Decimal(14, 2)
  lifetimeGrossUsd   Decimal   @default(0) @db.Decimal(14, 2)
  lifetimeNetUsd     Decimal   @default(0) @db.Decimal(14, 2)
  lifetimeWithdrawnUsd Decimal @default(0) @db.Decimal(14, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  creator            User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model CreatorEarningLedger {
  id                   String            @id @default(cuid())
  creatorId            String
  orderId              String?
  paymentTransactionId String?
  sourceType           EarningSourceType
  status               EarningStatus     @default(PENDING)
  grossAmountUsd       Decimal           @default(0) @db.Decimal(12, 2)
  platformFeeAmountUsd Decimal           @default(0) @db.Decimal(12, 2)
  netAmountUsd         Decimal           @default(0) @db.Decimal(12, 2)
  sourceTokens         Int?
  sourceEntityType     String?
  sourceEntityId       String?
  availableAt          DateTime?
  releasedAt           DateTime?
  reversedAt           DateTime?
  description          String?
  metadata             Json?
  createdAt            DateTime          @default(now())
  creator              User              @relation("CreatorEarnings", fields: [creatorId], references: [id], onDelete: Cascade)
  order                Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  withdrawalAllocations WithdrawalAllocation[]

  @@index([creatorId, status, availableAt])
  @@index([sourceEntityType, sourceEntityId])
}

model PayoutMethod {
  id                     String            @id @default(cuid())
  userId                 String
  type                   PayoutMethodType
  label                  String
  accountHolderName      String?
  accountReferenceMasked String?
  detailsEncrypted       String?           @db.Text
  countryCode            String?           @db.VarChar(2)
  settlementCurrencyCode String            @default("USD")
  isDefault              Boolean           @default(false)
  metadata               Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests     WithdrawalRequest[]

  @@index([userId, type, isDefault])
}

model WithdrawalRequest {
  id                     String             @id @default(cuid())
  creatorId              String
  payoutMethodId         String
  reviewedById           String?
  status                 WithdrawalStatus   @default(PENDING)
  requestedAmountUsd     Decimal            @default(0) @db.Decimal(12, 2)
  payoutFeeAmountUsd     Decimal            @default(0) @db.Decimal(12, 2)
  settlementCurrencyCode String             @default("USD")
  settlementAmount       Decimal?           @db.Decimal(18, 8)
  exchangeRate           Decimal?           @db.Decimal(18, 8)
  destinationSummary     String?
  notes                  String?            @db.Text
  externalReference      String?
  failureReason          String?            @db.Text
  reviewedAt             DateTime?
  processedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  creator                User               @relation("CreatorWithdrawalRequests", fields: [creatorId], references: [id], onDelete: Cascade)
  payoutMethod           PayoutMethod       @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  reviewedBy             User?              @relation("ReviewedWithdrawalRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  allocations            WithdrawalAllocation[]

  @@index([creatorId, status, createdAt])
}

model WithdrawalAllocation {
  id                  String               @id @default(cuid())
  withdrawalRequestId String
  earningLedgerId     String
  amountUsd           Decimal              @default(0) @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  withdrawalRequest   WithdrawalRequest    @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
  earningLedger       CreatorEarningLedger @relation(fields: [earningLedgerId], references: [id], onDelete: Cascade)

  @@unique([withdrawalRequestId, earningLedgerId])
}

model DirectPaymentSubmission {
  id                   String             @id @default(cuid())
  orderId              String             @unique
  paymentTransactionId String             @unique
  userId               String
  creatorId            String
  reviewerId           String?
  receiptAssetId       String?
  channel              DirectPaymentChannel
  reviewStatus         ManualReviewStatus @default(PENDING)
  amountCop            Decimal            @db.Decimal(12, 2)
  payerName            String
  payerIdentifier      String?
  payerPhone           String?
  reviewNotes          String?            @db.Text
  submittedAt          DateTime           @default(now())
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  user                 User               @relation("DirectPaymentsByUser", fields: [userId], references: [id], onDelete: Cascade)
  creator              User               @relation("DirectPaymentsForCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  reviewer             User?              @relation("DirectPaymentReviewers", fields: [reviewerId], references: [id], onDelete: SetNull)
  receiptAsset         MediaAsset?        @relation("DirectPaymentReceipt", fields: [receiptAssetId], references: [id], onDelete: SetNull)

  @@index([creatorId, reviewStatus, submittedAt])
}

model Review {
  id                String       @id @default(cuid())
  authorId          String
  creatorId         String
  contentId         String?
  orderId           String?
  rating            Int
  title             String?
  body              String?      @db.Text
  status            ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean     @default(false)
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  author            User         @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  creator           User         @relation("CreatorReviews", fields: [creatorId], references: [id], onDelete: Cascade)
  content           ContentItem? @relation("ContentReviews", fields: [contentId], references: [id], onDelete: SetNull)
  order             Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([creatorId, status, publishedAt])
}

model Conversation {
  id                 String             @id @default(cuid())
  creatorId          String
  customerId         String
  type               ConversationType   @default(PRIVATE_CHAT)
  status             ConversationStatus @default(ACTIVE)
  aiAutoReplyEnabled Boolean            @default(true)
  metadata           Json?
  lastMessageAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  creator            User               @relation("CreatorConversations", fields: [creatorId], references: [id], onDelete: Cascade)
  customer           User               @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  participants       ConversationParticipant[]
  messages           Message[]
  tips               Tip[]
  agentRuns          AIAgentRun[]
  agentMemories      AIAgentMemory[]

  @@index([creatorId, status, lastMessageAt])
  @@index([customerId, status, lastMessageAt])
}

model ConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String
  userId         String
  role           ParticipantRole
  isMuted        Boolean         @default(false)
  isPinned       Boolean         @default(false)
  lastReadAt     DateTime?
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id            String        @id @default(cuid())
  conversationId String
  senderId      String?
  senderRole    ParticipantRole @default(FAN)
  replyToId     String?
  agentRunId    String?
  messageType   MessageType   @default(TEXT)
  status        MessageStatus @default(SENT)
  body          String?       @db.Text
  isAutomated   Boolean       @default(false)
  isLocked      Boolean       @default(false)
  priceTokens   Int?
  metadata      Json?
  deliveredAt   DateTime?
  readAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User?         @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  replyTo       Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]     @relation("MessageReplies")
  agentRun      AIAgentRun?   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  unlocks       MessageUnlock[]
  tips          Tip[]
  agentMemories AIAgentMemory[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageUnlock {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  orderId     String?
  tokensSpent Int
  unlockedAt  DateTime  @default(now())
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([messageId, userId])
  @@index([orderId])
}

model Tip {
  id                   String        @id @default(cuid())
  fromUserId           String
  creatorId            String
  orderId              String?
  conversationId       String?
  liveSessionId        String?
  messageId            String?
  tokensAmount         Int
  platformFeeAmountUsd Decimal       @default(0) @db.Decimal(12, 2)
  creatorNetAmountUsd  Decimal       @default(0) @db.Decimal(12, 2)
  note                 String?       @db.Text
  createdAt            DateTime      @default(now())
  fromUser             User          @relation("TipsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  creator              User          @relation("TipsReceived", fields: [creatorId], references: [id], onDelete: Cascade)
  order                Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conversation         Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  liveSession          LiveSession?  @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  message              Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([conversationId])
  @@index([liveSessionId])
}

model AIAgentProfile {
  id                     String             @id @default(cuid())
  creatorId              String             @unique
  name                   String             @default("Mela")
  assistantHandle        String             @unique
  enabled                Boolean            @default(true)
  autoReplyEnabled       Boolean            @default(true)
  longTermMemoryEnabled  Boolean            @default(true)
  defaultModel           String?
  temperature            Decimal?           @db.Decimal(3, 2)
  systemPrompt           String             @db.Text
  modeConfig             Json?
  safetyConfig           Json?
  escalationKeywords     String[]           @default([])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  creator                User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  runs                   AIAgentRun[]
  memories               AIAgentMemory[]
  automationRules        AIAutomationRule[]
}

model AIAgentRun {
  id               String         @id @default(cuid())
  agentId          String
  conversationId   String?
  triggeredByUserId String?
  mode             AgentMode
  status           AgentRunStatus @default(QUEUED)
  model            String?
  promptVersion    String?
  inputSummary     String?        @db.Text
  outputSummary    String?        @db.Text
  errorMessage     String?        @db.Text
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal?       @db.Decimal(10, 4)
  latencyMs        Int?
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  metadata         Json?
  agent            AIAgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  triggeredByUser  User?          @relation("TriggeredAgentRuns", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@index([agentId, status, startedAt])
}

model AIAgentMemory {
  id                   String         @id @default(cuid())
  agentId              String
  fanUserId            String
  sourceConversationId String?
  sourceMessageId      String?
  type                 MemoryType
  title                String
  summary              String         @db.Text
  importance           Int            @default(1)
  lastObservedAt       DateTime       @default(now())
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  agent                AIAgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fanUser              User           @relation("FanMemories", fields: [fanUserId], references: [id], onDelete: Cascade)
  sourceConversation   Conversation?  @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage        Message?       @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([agentId, fanUserId, type])
}

model AIAutomationRule {
  id          String             @id @default(cuid())
  agentId     String
  name        String
  trigger     AutomationTrigger
  action      AutomationAction
  isActive    Boolean            @default(true)
  priority    Int                @default(100)
  conditions  Json?
  actionConfig Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  agent       AIAgentProfile     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@index([agentId, isActive, priority])
}

model LiveSession {
  id               String            @id @default(cuid())
  creatorId        String
  title            String
  description      String?           @db.Text
  provider         LiveProvider      @default(LIVEKIT)
  accessType       LiveAccessType    @default(FREE)
  status           LiveSessionStatus @default(SCHEDULED)
  roomName         String?           @unique
  externalRoomId   String?
  scheduledStartAt DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  minimumTipTokens Int               @default(20)
  entryPriceTokens Int?
  peakViewers      Int               @default(0)
  totalTipsTokens  Int               @default(0)
  replayAssetId    String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation("CreatorLiveSessions", fields: [creatorId], references: [id], onDelete: Cascade)
  replayAsset      MediaAsset?       @relation("LiveReplayAsset", fields: [replayAssetId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  viewers          LiveSessionViewer[]
  tips             Tip[]

  @@index([creatorId, status, scheduledStartAt])
}

model LiveSessionViewer {
  id                String      @id @default(cuid())
  liveSessionId     String
  userId            String
  joinedAt          DateTime    @default(now())
  lastSeenAt        DateTime?
  totalMinutesWatched Int       @default(0)
  totalTokensSpent  Int         @default(0)
  isSubscriberAtJoin Boolean    @default(false)
  liveSession       LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([userId, joinedAt])
}

model CustomRequest {
  id               String             @id @default(cuid())
  orderItemId      String             @unique
  creatorId        String
  customerId       String
  serviceOfferingId String
  deliveryContentId String?
  status           CustomRequestStatus @default(PENDING)
  title            String
  brief            String             @db.Text
  requirements     Json?
  requestedFor     DateTime?
  dueAt            DateTime?
  deliveredAt      DateTime?
  creatorNotes     String?            @db.Text
  customerNotes    String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orderItem        OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  creator          User               @relation("CustomRequestsCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  customer         User               @relation("CustomRequestsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  serviceOffering  ServiceOffering    @relation(fields: [serviceOfferingId], references: [id], onDelete: Restrict)
  deliveryContent  ContentItem?       @relation("DeliveredContent", fields: [deliveryContentId], references: [id], onDelete: SetNull)

  @@index([creatorId, status, dueAt])
  @@index([customerId, status, createdAt])
}

model AgeVerificationCheck {
  id               String             @id @default(cuid())
  userId           String
  provider         String
  status           VerificationStatus @default(PENDING)
  externalReference String?
  documentType     String?
  documentCountry  String?            @db.VarChar(2)
  submittedAt      DateTime?
  verifiedAt       DateTime?
  expiresAt        DateTime?
  rejectionReason  String?            @db.Text
  payload          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model KycCheck {
  id               String             @id @default(cuid())
  userId           String
  provider         String
  status           VerificationStatus @default(PENDING)
  externalReference String?
  submittedAt      DateTime?
  verifiedAt       DateTime?
  expiresAt        DateTime?
  rejectionReason  String?            @db.Text
  payload          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model UserConsent {
  id         String      @id @default(cuid())
  userId     String
  type       ConsentType
  version    String
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  title     String
  body      String             @db.Text
  actionUrl String?
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventType   String
  externalId  String
  status      WebhookStatus @default(PENDING)
  payload     Json
  errorMessage String?      @db.Text
  processedAt DateTime?
  receivedAt  DateTime      @default(now())

  @@unique([provider, externalId])
  @@index([provider, status, receivedAt])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorUserId String?
  targetType String
  targetId   String?
  action     String
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  actorUser  User?          @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
}
